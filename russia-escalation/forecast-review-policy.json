    "new_evidence",
    "source_correction",
    "factual_error",
    "adjudication_error"
  ],
  "dependency_policy": "Report distinct dependency groups and windows. Groups are not proven independent; effective sample size is not computed by multiplying counts.",
  "provenance_note": "CLI issuance times are local records, not an independent trusted timestamp. Git/public deployment history provides the external publication trail; do not claim cryptographic notarisation."
